<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!--
      Exclude the benchmark harness from SonarQube/SonarCloud analysis. Benchmarks are
      deliberately written in a non-idiomatic style: explicit foreach/counter loops are kept
      identical across competing collections so the comparisons stay fair, which Sonar reports
      as S3267 ("use Where"), and operations on intentionally-empty collections read as S4158.
      Benchmark code is also never executed by the test suite, so it can only ever drag the
      new-code coverage gate to 0%. It is not shipped in the package.
    -->
    <SonarQubeExclude>true</SonarQubeExclude>
    <!--
      CA5394: benchmarks seed System.Random with a fixed value (new Random(42)) so every run
      measures the same input sequence. Reproducibility is the point; a cryptographic RNG would
      defeat it, and no benchmark input is security-sensitive.
      KTSU0002: InternalsVisibleTo targets the test project. Nothing tests the benchmark harness,
      and it exposes no internals worth reaching.
    -->
    <NoWarn>$(NoWarn);CA5394;KTSU0002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Benchmark attributes ([MemoryDiagnoser], [SimpleJob], [Params]) live here; referenced
         directly rather than relied on transitively through BenchmarkDotNet (KTSU0006). -->
    <PackageReference Include="BenchmarkDotNet.Annotations" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Containers\Containers.csproj" />
  </ItemGroup>
</Project>
